# Global justfile — recipes available from any directory.
#
# Managed by home-manager (programs/just.nix), symlinked to
# ~/.config/just/justfile. Run these anywhere:
#   - `just <recipe>` when the current dir has NO local justfile (the shell
#     wrapper in home.nix falls back to --global-justfile), or
#   - `just -g <recipe>` explicitly, even inside a project that has its own justfile.
#
# List recipes:  just -g   (or just `just` in a dir with no local justfile)

# Default: show the available global recipes.
default:
    @just -g --list --unsorted

# Switch the nix-darwin / home-manager config (mirrors the `homeswitch` shell fn).
switch:
    sudo darwin-rebuild switch --flake ~/src/workspace

# Update flake inputs in the workspace config.
update:
    cd ~/src/workspace && nix flake update

# Garbage-collect nix generations older than 14 days (opt-in cleanup).
gc days="14":
    sudo nix-collect-garbage --delete-older-than {{days}}d

# Show the current external IP.
myip:
    @curl -fsSL https://api.ipify.org && echo

# Make a directory and cd into it is shell-only; instead: create nested dirs.
mkdir path:
    mkdir -p {{path}}

# Serve the current directory over HTTP on PORT (default 8000).
serve port="8000":
    python3 -m http.server {{port}}

# Show the largest files/dirs under the current directory (top 20).
biggest:
    @du -ah . 2>/dev/null | sort -rh | head -20

# Upgrade OmniWM on purpose. Rebuilds keep the omniwm cask PINNED (see the
# omniwm note in darwin.nix): an upgrade under the running app breaks
# omniwmctl -- Caps+F5/Caps+6, the bar, cmux-attention, triage -- until OmniWM
# restarts, and a restart piles every window onto one workspace. So this is
# the one place it upgrades: shows installed vs available, asks, quits
# OmniWM, upgrades, re-pins, reopens it and waits for `omniwmctl ping`.
# Refuses when nothing is newer, unless the running app is already stale, in
# which case it offers just the restart.

# Upgrade OmniWM and restart it (rebuilds never upgrade it; it is pinned).
omniwm-upgrade:
    #!/usr/bin/env bash
    set -euo pipefail
    cask=omniwm
    bundle_id=com.barut.OmniWM

    # A restart is disruptive, so every one is asked for; no terminal, no.
    ask() {
        local reply
        { exec 3</dev/tty; } 2>/dev/null || return 1
        read -r -u 3 -p "$1 [y/N] " reply || return 1
        exec 3<&-
        [[ "$reply" == [yY]* ]]
    }
    # Bounded (no coreutils timeout on PATH), so a hung OmniWM cannot stall
    # this; perl's alarm survives the exec and kills omniwmctl after 3s.
    ctl() { perl -e 'alarm 3; exec @ARGV' omniwmctl "$@"; }
    ping_ok() { [ "$(ctl ping 2>/dev/null)" = pong ]; }

    # Set once OmniWM has been quit, so the EXIT trap below knows to reopen it
    # and to print the /triage reminder however the run ends.
    restarted=""
    unpinned=""
    on_exit() {
        if [ -n "$unpinned" ]; then
            brew pin --cask "$cask" >/dev/null 2>&1 \
                || echo "warning: could not re-pin omniwm; run: brew pin --cask omniwm" >&2
        fi
        if [ -n "$restarted" ]; then
            pgrep -xq OmniWM || open -b "$bundle_id" || true
            echo
            echo "OmniWM restarted, so every window is on one workspace and the scratchpads are empty:"
            echo "  - run /triage in Claude to put windows back on their workspaces"
            echo "  - re-assign the scratchpads with Caps+Shift+S / T / E / C"
        fi
    }
    trap on_exit EXIT

    # Graceful quit first (an Apple Event, so OmniWM can tidy up; the first
    # time, macOS may ask to let this terminal control OmniWM). Backgrounded
    # because that prompt blocks osascript; escalate if it has not exited.
    quit_omniwm() {
        restarted=1
        if ! pgrep -xq OmniWM; then
            echo "OmniWM is not running."
            return 0
        fi
        echo "Quitting OmniWM..."
        osascript -e "tell application id \"$bundle_id\" to quit" >/dev/null 2>&1 &
        local osa=$!
        for _ in $(seq 1 20); do pgrep -xq OmniWM || break; sleep 0.5; done
        if pgrep -xq OmniWM; then pkill -TERM -x OmniWM || true; sleep 3; fi
        if pgrep -xq OmniWM; then pkill -KILL -x OmniWM || true; sleep 1; fi
        kill "$osa" 2>/dev/null || true
        wait "$osa" 2>/dev/null || true
        if pgrep -xq OmniWM; then
            echo "error: OmniWM would not quit." >&2
            return 1
        fi
    }

    start_omniwm() {
        echo "Opening OmniWM..."
        open -b "$bundle_id"
        for _ in $(seq 1 60); do
            if ping_ok; then
                echo "omniwmctl ping -> pong (OmniWM $(ctl version 2>/dev/null || echo '?'))."
                return 0
            fi
            sleep 0.5
        done
        echo "error: OmniWM did not answer omniwmctl ping within 30s; last reply:" >&2
        ctl ping >&2 || true
        return 1
    }

    echo "Checking for a newer omniwm..."
    brew update --quiet >/dev/null || echo "warning: brew update failed; comparing against the local index" >&2
    read -r installed available < <(brew info --cask --json=v2 "$cask" \
        | jq -r '.casks[0] | "\(.installed // "-") \(.version)"') \
        || { echo "error: could not read the omniwm versions from brew info." >&2; exit 1; }
    if [ "$installed" = "-" ]; then
        echo "error: the omniwm cask is not installed; darwin-rebuild installs it (darwin.nix)." >&2
        exit 1
    fi
    echo "omniwm: installed $installed, available $available"

    # Newer only if `available` sorts strictly after `installed`; a cask
    # rolled back upstream would otherwise be offered as an "upgrade" that
    # brew carries out as a downgrade.
    newest="$(printf '%s\n%s\n' "$installed" "$available" | sort -V | tail -n 1)"
    if [ "$installed" = "$available" ] || [ "$newest" = "$installed" ]; then
        if ping_ok; then
            echo "Nothing newer, and omniwmctl reaches OmniWM; nothing to do."
            exit 0
        fi
        echo "Nothing newer, but omniwmctl cannot reach a running OmniWM (not running, or still"
        echo "the app from before the last upgrade). A restart fixes that; there is nothing to upgrade."
        ask "Restart OmniWM now?" || { echo "Left as is."; exit 0; }
        quit_omniwm
        start_omniwm
        exit 0
    fi

    echo "Upgrading quits OmniWM, which piles every window onto one workspace and empties the scratchpads."
    ask "Upgrade omniwm $installed -> $available and restart OmniWM now?" || { echo "Not upgraded."; exit 0; }

    # The pin blocks even a named `brew upgrade --cask`, so lift it for this
    # one upgrade; on_exit re-pins on every exit path, so a failed or
    # interrupted run cannot leave it for the next rebuild to upgrade.
    quit_omniwm
    unpinned=1
    brew unpin --cask "$cask" >/dev/null 2>&1 || true
    if ! HOMEBREW_NO_AUTO_UPDATE=1 brew upgrade --cask "$cask"; then
        echo "error: brew upgrade failed; reopening the existing OmniWM." >&2
        start_omniwm || true
        exit 1
    fi
    start_omniwm
